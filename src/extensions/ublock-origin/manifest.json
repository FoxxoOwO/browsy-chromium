{
  "manifest_version": 2,
  "name": "uBlock Origin (Integrovaný)",
  "short_name": "uBlock Origin",
  "version": "1.58.0",
  "description": "Integrovaný efektivní blokátor reklam, sledovacích skriptů a malware.",
  "author": "Raymond Hill / Browsy Chromium",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "tabs",
    "storage",
    "unlimitedStorage"
  ],
  "browser_action": {
    "default_icon": "icon.png",
    "default_title": "uBlock Origin",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}

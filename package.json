{
  "name": "browsy-chromium",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:ui": "vite build",
    "build:native": "cargo build --release --manifest-path src-native/Cargo.toml && node scripts/copy-native.js",
    "build": "npm run build:native && npm run build:ui",
    "build:android": "cd android && .\\gradlew assembleDebug",
    "package:exe": "npm run build:ui && node scripts/package-exe.js",
    "package:apk": "cd android && .\\gradlew assembleDebug && node ../scripts/package-apk.js",
    "test:android": "cd android && .\\gradlew test",
    "test": "node tests/verify-launch.js"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "adm-zip": "^0.6.1"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "electron": "^44.8.0",
    "svelte": "^5.57.2",
    "vite": "^8.3.4"
  }
}
